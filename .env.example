# PostgreSQL connection string.
# For Supabase use the connection pooler (IPv4), e.g.:
#   session pooler (direct migrations/CLI):   postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
#   transaction pooler (serverless runtime):  postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
# (N is 0 or 1 depending on the project's provisioning generation — check the
#  "Connect" dialog in Supabase. Using the wrong family yields
#  "tenant/user ... not found".)
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: require HTTP Basic Auth for the whole site when deployed.
# Leave unset in local development to keep the site open.
# SITE_AUTH_USER=robeh
# SITE_AUTH_PASSWORD=change-me

# Optional: pool size (defaults to 5)
# PG_POOL_MAX=5

# Optional: protects /api/cron/* endpoints. When set, Vercel automatically
# sends it as a Bearer token with cron invocations.
# CRON_SECRET=change-me-long-random-string
